NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/outbox?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/outbox?schema=public
