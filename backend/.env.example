GOOGLE_CLIENT_SECRET=mock-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

SESSION_SECRET=reachinbox-dev-session-secret-at-least-32-chars-long
SLACK_CLIENT_ID=mock-slack-client-id
SLACK_CLIENT_SECRET=mock-slack-client-secret
SLACK_CALLBACK_URL=https://mock-tunnel.ngrok-free.app/integrations/slack/callback
# 32-byte base64 string: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=T+PIm0Y/sPaSFdPgH33mMfeITS5ENvDdT3OH8gI7Oew=

ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
ETHEREAL_USER=
ETHEREAL_PASS=

WORKER_CONCURRENCY=5
MIN_DELAY_BETWEEN_SENDS_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=100
MAX_EMAILS_PER_HOUR_GLOBAL=200
RATE_LIMIT_TIMEZONE=UTC
ADMIN_EMAILS=admin@reachinbox.ai

MAX_RECIPIENTS=5000
MAX_UPLOAD_BYTES=2097152
RUN_WORKER=false
